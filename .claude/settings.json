{
  "permissions": {
    "allow": [
      "Bash(./scripts/arch)",
      "Bash(./scripts/bundle:*)",
      "Bash(./scripts/check)",
      "Bash(./scripts/dev:*)",
      "Bash(./scripts/format)",
      "Bash(./scripts/setup)",
      "Bash(./scripts/test:*)",
      "Bash(swift build:*)",
      "Bash(swift test:*)"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Edit(.env)",
      "Edit(.env.*)"
    ]
  }
}
