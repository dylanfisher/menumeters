#!/usr/bin/env bash
# The gate. Everything must pass before work is considered done.
# Keep this the ONLY command anyone, human or agent, needs to remember.
#
# Every step runs even if an earlier one fails, so one invocation reports every
# problem. Fixing four failures should cost one run, not four.
set -uo pipefail
cd "$(dirname "$0")/.."

failures=()

# run <name> <command...>: print a header, run it, record the failure, continue.
run() {
  local name="$1"; shift
  printf '\n\033[1m▸ %s\033[0m\n' "$name"
  if ! "$@"; then failures+=("$name"); fi
}

# AGENTS.md is the highest-leverage file in the repo and the easiest to let rot.
# The limit here is the one the file states in its first lines.
run agents.md bash -c '
  lines=$(wc -l < AGENTS.md | tr -d " ")
  if [ "$lines" -gt 50 ]; then
    echo "AGENTS.md is $lines lines (limit 50). Move a section to docs/ and link it." >&2; exit 1
  fi
  if grep -q "{{" AGENTS.md; then echo "AGENTS.md has unfilled {{PLACEHOLDER}}s." >&2; exit 1; fi
  echo "$lines lines, no placeholders"
'

# The project was copied from a template with placeholders in double braces. One
# left behind builds fine and ships the wrong bundle ID or folder name, so look
# in every file git would commit. This script is skipped: it names the pattern.
run placeholders bash -c '
  files=$(git ls-files --cached --others --exclude-standard) || {
    echo "not a git repository; run git init first." >&2; exit 1
  }
  bad=""
  for f in $files; do
    [ "$f" = scripts/check ] && continue
    [ -f "$f" ] && grep -q -F "{{" "$f" && bad="$bad $f"
  done
  if [ -n "$bad" ]; then echo "unfilled {{PLACEHOLDER}}s in:$bad" >&2; exit 1; fi
  echo "no placeholders left"
'

# The code map claims where things live. Verify the claim: a rename that misses
# docs/map.md turns it into confident misdirection, which is worse than no map.
run map bash -c '
  paths=$(grep "^<!-- paths:" docs/map.md | sed "s/^<!-- paths: //; s/ -->//")
  if [ -z "$paths" ]; then
    echo "docs/map.md is missing its <!-- paths: ... --> line." >&2; exit 1
  fi
  missing=""
  for p in $paths; do [ -e "$p" ] || missing="$missing $p"; done
  if [ -n "$missing" ]; then
    echo "docs/map.md names paths that do not exist:$missing" >&2; exit 1
  fi
  echo "tiers exist: $paths"
'

# AGENTS.md stays small by linking instead of restating, so a dead link is the
# pointer to the real instruction going missing. `find` rather than
# `git ls-files`, so a checkout with nothing committed is still checked.
run links bash -c '
  files=$(find . -name "*.md" -not -path "./.git/*" -not -path "./.build/*")
  if [ -z "$files" ]; then echo "no markdown found; this check is not looking where it should." >&2; exit 1; fi
  bad=""
  for f in $files; do
    for link in $(grep -oE "\]\([^)]+\)" "$f" | sed "s/^](//; s/)$//"); do
      case "$link" in http*|mailto:*|\#*) continue ;; esac
      target="${link%%#*}"
      [ -z "$target" ] && continue
      [ -e "$(dirname "$f")/$target" ] || bad="$bad
    $f → $link"
    done
  done
  if [ -n "$bad" ]; then echo "markdown links point at nothing:$bad" >&2; exit 1; fi
  echo "all relative links resolve"
'

run format    swift format lint --strict --recursive --parallel Package.swift Sources Tests
# The build is the typecheck: Swift 6 mode, warnings as errors. Importing a target that isn't a
# declared dependency fails here too.
run typecheck swift build --build-tests --explicit-target-dependency-import-check error
run arch      ./scripts/arch
run test      ./scripts/test

if [ ${#failures[@]} -gt 0 ]; then
  printf '\n\033[31m✗ failed: %s\033[0m\n' "${failures[*]}" >&2
  exit 1
fi

printf '\n\033[32m✓ all checks passed\033[0m\n'
