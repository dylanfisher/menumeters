#!/usr/bin/env bash
# Get a clean checkout to a runnable state. Safe to run again.
set -euo pipefail
cd "$(dirname "$0")/.."

chmod +x scripts/*

# The commit-msg hook is optional: it checks commit titles against docs/writing.md before
# they are written. Delete this line and scripts/commit-msg to go without it.
ln -sf ../../scripts/commit-msg .git/hooks/commit-msg

echo "✓ setup complete"
