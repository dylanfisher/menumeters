#!/usr/bin/env bash
# Build the app as a bundle and launch it, quitting a running copy first. The one place the run
# command is written down. Extra arguments go to scripts/bundle: `./scripts/dev -c release`.
set -euo pipefail
cd "$(dirname "$0")/.."

# Launched as a bundle, not with `swift run`, so the system treats it as its own app.
app=$(./scripts/bundle "$@")

# `open` brings a running copy to the front instead of starting the new build, so quit it first
# and wait until it has gone. The quit doesn't wait for a reply, so a hung copy hits the 5 s
# limit below rather than AppleScript's 2 minutes.
id=$(plutil -extract CFBundleIdentifier raw "$app/Contents/Info.plist")
running() { [ -n "$(lsappinfo info -only pid -app "$id")" ]; }
if running; then
  osascript -e "ignoring application responses" -e "quit app id \"$id\"" -e "end ignoring"
  for _ in $(seq 50); do running || break; sleep 0.1; done
  if running; then
    printf 'running %s did not quit within 5 s; quit it and run again\n' "$id" >&2
    exit 1
  fi
fi

open "$app"
echo "launched; logs: log stream --predicate 'subsystem == \"$id\"'" >&2
